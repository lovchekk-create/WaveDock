<Window x:Class="WaveDock.PlayerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:WaveDock"
        Title="WaveDock Player" Width="560" Height="524"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" Topmost="True" ResizeMode="NoResize"
        FontFamily="Segoe UI Variable Display, Segoe UI" UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Ideal">
    <Window.Resources>
        <LinearGradientBrush x:Key="AccentBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#9945FF" Offset="0"/>
            <GradientStop Color="#14F195" Offset="1"/>
        </LinearGradientBrush>
    </Window.Resources>

    <Grid>
    <!-- карточка с текстом песни (над плеером) -->
    <Grid x:Name="LyricsCard" Margin="26,26,26,0" Height="224" VerticalAlignment="Top"
          Opacity="0" IsHitTestVisible="False" Visibility="Hidden" RenderTransformOrigin="0.5,1">
        <Grid.RenderTransform>
            <TransformGroup>
                <ScaleTransform x:Name="LyrScale" ScaleX="1" ScaleY="1"/>
                <TranslateTransform x:Name="LyrShift"/>
            </TransformGroup>
        </Grid.RenderTransform>
        <Border CornerRadius="24" Background="#FF0F0D18">
            <Border.Effect>
                <DropShadowEffect x:Name="LyrGlow" BlurRadius="30" ShadowDepth="0" Opacity="0.45" Color="#9945FF"/>
            </Border.Effect>
        </Border>
        <Grid x:Name="LyrBg" IsHitTestVisible="False">
            <Image x:Name="LyrBgCover" Stretch="UniformToFill" Opacity="0.4" Margin="-50">
                <Image.Effect><BlurEffect Radius="70" RenderingBias="Performance"/></Image.Effect>
            </Image>
            <Border>
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#B30D0B17" Offset="0"/>
                        <GradientStop Color="#EB060510" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
            </Border>
        </Grid>
        <Border CornerRadius="24" BorderBrush="#24FFFFFF" BorderThickness="1" IsHitTestVisible="False"/>
        <Grid Margin="24,16,24,14">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid>
                <TextBlock Text="ТЕКСТ ПЕСНИ" FontSize="11" FontWeight="SemiBold" Foreground="#8CFFFFFF"/>
                <TextBlock x:Name="LyrSource" Text="lrclib.net" FontSize="11" Foreground="#59FFFFFF" HorizontalAlignment="Right"/>
            </Grid>
            <Grid x:Name="LyrViewport" Grid.Row="1" Margin="0,6,0,0" ClipToBounds="True" Background="Transparent" MouseWheel="LyricsCard_MouseWheel">
                <Grid.OpacityMask>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#00000000" Offset="0"/>
                        <GradientStop Color="#FF000000" Offset="0.16"/>
                        <GradientStop Color="#FF000000" Offset="0.84"/>
                        <GradientStop Color="#00000000" Offset="1"/>
                    </LinearGradientBrush>
                </Grid.OpacityMask>
                <StackPanel x:Name="LyrLines" VerticalAlignment="Top">
                    <StackPanel.RenderTransform><TranslateTransform x:Name="LyrScroll"/></StackPanel.RenderTransform>
                </StackPanel>
                <TextBlock x:Name="LyrStatus" Text="Ищу текст…" FontSize="15" Foreground="#99FFFFFF"
                           HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center"/>
            </Grid>
        </Grid>
    </Grid>

    <Grid x:Name="Root" Margin="26" Height="222" VerticalAlignment="Bottom" RenderTransformOrigin="0.1,1">
        <Grid.RenderTransform>
            <TransformGroup>
                <ScaleTransform x:Name="RootScale" ScaleX="1" ScaleY="1"/>
                <TranslateTransform x:Name="RootShift"/>
            </TransformGroup>
        </Grid.RenderTransform>

        <!-- подложка со свечением в цвет обложки -->
        <Border CornerRadius="26" Background="#F00F0D18">
            <Border.Effect>
                <DropShadowEffect x:Name="Glow" BlurRadius="34" ShadowDepth="0" Opacity="0.55" Color="#9945FF"/>
            </Border.Effect>
        </Border>

        <Grid x:Name="Card">
            <!-- размытая обложка на фоне -->
            <Image x:Name="BgCover" Stretch="UniformToFill" Opacity="0.5" Margin="-50">
                <Image.Effect><BlurEffect Radius="60" RenderingBias="Performance"/></Image.Effect>
            </Image>
            <Border>
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#A60D0B17" Offset="0"/>
                        <GradientStop Color="#E6060510" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
            </Border>
            <local:WaveView x:Name="BgWave" DrawBackground="False" Radius="0" WaveScale="1.5"
                            Height="96" VerticalAlignment="Bottom" Opacity="0.32" IsHitTestVisible="False"/>
            <Border CornerRadius="26" BorderThickness="1" BorderBrush="#24FFFFFF" IsHitTestVisible="False"/>

            <Grid Margin="22">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border x:Name="CoverHost" Width="150" Height="150" CornerRadius="20"
                        VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5" Background="{DynamicResource AccentBrush}">
                    <Border.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform x:Name="CoverScale" ScaleX="1" ScaleY="1"/>
                            <RotateTransform x:Name="CoverRotate" Angle="0"/>
                        </TransformGroup>
                    </Border.RenderTransform>
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="26" ShadowDepth="8" Direction="270" Opacity="0.55" Color="Black"/>
                    </Border.Effect>
                    <TextBlock x:Name="CoverPlaceholder" Text="&#xE8D6;" FontFamily="{StaticResource Icons}" FontSize="52"
                               Foreground="#CCFFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>

                <StackPanel Grid.Column="1" Margin="20,0,0,0" VerticalAlignment="Center">
                    <TextBlock x:Name="AppText" Text="WAVEDOCK" FontSize="11" FontWeight="SemiBold" Foreground="#8CFFFFFF" Margin="0,0,84,0"/>
                    <TextBlock x:Name="TitleText" Text="Ничего не играет" FontSize="21" FontWeight="SemiBold"
                               Foreground="White" TextTrimming="CharacterEllipsis" Margin="0,5,0,0"/>
                    <TextBlock x:Name="ArtistText" Text="" FontSize="14" Foreground="#B3FFFFFF"
                               TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>

                    <Grid x:Name="ProgressArea" Margin="0,12,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="14"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid x:Name="Track" Background="Transparent" Cursor="Hand" MouseLeftButtonDown="Track_MouseLeftButtonDown">
                            <Border Height="4" CornerRadius="2" Background="#26FFFFFF" VerticalAlignment="Center"/>
                            <Border x:Name="ProgressFill" Height="4" CornerRadius="2" Width="0"
                                    HorizontalAlignment="Left" VerticalAlignment="Center" Background="{DynamicResource AccentBrush}"/>
                            <Ellipse x:Name="Knob" Width="10" Height="10" Fill="White"
                                     HorizontalAlignment="Left" VerticalAlignment="Center">
                                <Ellipse.Effect><DropShadowEffect BlurRadius="8" ShadowDepth="0" Opacity="0.6" Color="White"/></Ellipse.Effect>
                            </Ellipse>
                        </Grid>
                        <Grid Grid.Row="1">
                            <TextBlock x:Name="PosText" Text="0:00" FontSize="11" Foreground="#80FFFFFF"/>
                            <TextBlock x:Name="DurText" Text="0:00" FontSize="11" Foreground="#80FFFFFF" HorizontalAlignment="Right"/>
                        </Grid>
                    </Grid>

                    <DockPanel x:Name="ControlsRow" Margin="0,8,0,0" LastChildFill="True">
                        <Button x:Name="PrevBtn" DockPanel.Dock="Left" Style="{StaticResource IconBtn}" Content="&#xE892;" Click="Prev_Click" ToolTip="Предыдущий"/>
                        <Button x:Name="PlayBtn" DockPanel.Dock="Left" Style="{StaticResource PlayBtn}" Content="&#xE768;" Margin="12,0" Click="Play_Click" ToolTip="Пауза / воспроизведение"/>
                        <Button x:Name="NextBtn" DockPanel.Dock="Left" Style="{StaticResource IconBtn}" Content="&#xE893;" Click="Next_Click" ToolTip="Следующий"/>
                        <Button x:Name="MuteBtn" DockPanel.Dock="Left" Style="{StaticResource IconBtn}" Width="32" Height="32" FontSize="14"
                                Background="Transparent" Margin="14,0,2,0" Content="&#xE995;" Click="Mute_Click" ToolTip="Без звука"/>
                        <Slider x:Name="VolSlider" Style="{StaticResource ModernSlider}" Margin="0,0,4,0" Minimum="0" Maximum="100"
                                ValueChanged="VolSlider_ValueChanged" ToolTip="Громкость"/>
                    </DockPanel>
                </StackPanel>
            </Grid>
            <Button x:Name="LyricsBtn" Style="{StaticResource IconBtn}" Width="30" Height="30" FontSize="13"
                    HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,12,48,0" Panel.ZIndex="5"
                    Content="&#xE8A5;" Click="Lyrics_Click" ToolTip="Текст песни"/>
            <Button x:Name="GearBtn" Style="{StaticResource IconBtn}" Width="30" Height="30" FontSize="13"
                    HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,12,12,0" Panel.ZIndex="5"
                    Click="Gear_Click" ToolTip="Настройки">
                <TextBlock x:Name="GearGlyph" Text="&#xE713;" RenderTransformOrigin="0.5,0.5">
                    <TextBlock.RenderTransform><RotateTransform x:Name="GearRotate"/></TextBlock.RenderTransform>
                </TextBlock>
            </Button>
        </Grid>
    </Grid>
    </Grid>
</Window>
