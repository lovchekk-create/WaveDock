<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>WaveDock</AssemblyName>
    <RootNamespace>WaveDock</RootNamespace>
    <Version>1.3.0</Version>
    <ApplicationIcon>wavedock.ico</ApplicationIcon>
    <Product>WaveDock</Product>
    <Company>WaveDock</Company>
    <Description>WaveDock — музыкальный виджет для панели задач Windows 11</Description>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="wavedock.ico" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="NAudio.Wasapi" Version="2.2.1" />
  </ItemGroup>
</Project>
