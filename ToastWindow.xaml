<Window x:Class="WaveDock.ToastWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WaveDock" Width="380" Height="118"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" Topmost="True" ResizeMode="NoResize" ShowActivated="False"
        FontFamily="Segoe UI Variable Display, Segoe UI" UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Ideal" Cursor="Hand">
    <Window.Resources>
        <LinearGradientBrush x:Key="AccentBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#9945FF" Offset="0"/>
            <GradientStop Color="#14F195" Offset="1"/>
        </LinearGradientBrush>
    </Window.Resources>

    <Grid x:Name="Root" Margin="20" RenderTransformOrigin="0.15,1">
        <Grid.RenderTransform>
            <TransformGroup>
                <ScaleTransform x:Name="ToastScale" ScaleX="1" ScaleY="1"/>
                <TranslateTransform x:Name="ToastShift"/>
            </TransformGroup>
        </Grid.RenderTransform>

        <Border CornerRadius="18" Background="#F40F0D18" BorderBrush="#26FFFFFF" BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect x:Name="Glow" BlurRadius="26" ShadowDepth="0" Opacity="0.55" Color="#9945FF"/>
            </Border.Effect>
        </Border>
        <!-- полоска-таймер снизу -->
        <Border x:Name="TimerBar" Height="3" CornerRadius="1.5" VerticalAlignment="Bottom" HorizontalAlignment="Left"
                Margin="16,0,16,6" Background="{DynamicResource AccentBrush}" Opacity="0.8" Width="0"/>

        <Grid Margin="10">
            <!-- новый трек -->
            <Grid x:Name="TrackPanel">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border x:Name="Cover" Width="56" Height="56" CornerRadius="12" RenderTransformOrigin="0.5,0.5">
                    <Border.RenderTransform><ScaleTransform x:Name="CoverScale"/></Border.RenderTransform>
                    <Border.Effect><DropShadowEffect BlurRadius="14" ShadowDepth="3" Direction="270" Opacity="0.5" Color="Black"/></Border.Effect>
                </Border>
                <StackPanel Grid.Column="1" Margin="14,0,8,0" VerticalAlignment="Center">
                    <TextBlock x:Name="Caption" Text="СЕЙЧАС ИГРАЕТ" FontSize="10.5" FontWeight="SemiBold" Foreground="#8CFFFFFF"/>
                    <TextBlock x:Name="TitleText" FontSize="15.5" FontWeight="SemiBold" Foreground="White" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                    <TextBlock x:Name="ArtistText" FontSize="12.5" Foreground="#B3FFFFFF" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </Grid>

            <!-- громкость -->
            <Grid x:Name="VolumePanel" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="VolIcon" FontFamily="{StaticResource Icons}" FontSize="22" Foreground="White"
                           VerticalAlignment="Center" Margin="10,0,16,0"/>
                <Grid x:Name="VolTrack" Grid.Column="1" VerticalAlignment="Center" Height="6">
                    <Border CornerRadius="3" Background="#26FFFFFF"/>
                    <Border x:Name="VolFill" CornerRadius="3" HorizontalAlignment="Left" Width="0" Background="{DynamicResource AccentBrush}"/>
                </Grid>
                <TextBlock x:Name="VolText" Grid.Column="2" FontSize="16" FontWeight="SemiBold" Foreground="White"
                           VerticalAlignment="Center" Margin="16,0,10,0" MinWidth="44" TextAlignment="Right"/>
            </Grid>
        </Grid>
    </Grid>
</Window>
