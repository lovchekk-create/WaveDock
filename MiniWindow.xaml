<Window x:Class="WaveDock.MiniWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:WaveDock"
        Title="WaveDock" Width="46" Height="46"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" Topmost="True" ResizeMode="NoResize" ShowActivated="False"
        Cursor="Hand" ToolTip="Клик — плеер · Средняя кнопка — пауза · Колесо — треки · Перетащи — сдвинуть">
    <Grid x:Name="Root" Background="#01000000" RenderTransformOrigin="0.5,0.5">
        <Grid.RenderTransform>
            <ScaleTransform x:Name="RootScale" ScaleX="1" ScaleY="1"/>
        </Grid.RenderTransform>
        <local:WaveView x:Name="Wave" Margin="6" Radius="10">
            <local:WaveView.Effect>
                <DropShadowEffect x:Name="MiniGlow" BlurRadius="12" ShadowDepth="0" Opacity="0.7" Color="#9945FF"/>
            </local:WaveView.Effect>
        </local:WaveView>
    </Grid>
</Window>
